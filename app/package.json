    "sonner": "^2.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^5.2.1",
